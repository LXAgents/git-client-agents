# Rendered by the nginx image at start (envsubst), so PORT comes from the platform.
server {
  listen ${PORT};
  root /usr/share/nginx/html;

  # Hashed build output never changes, so it can be cached for a long time.
  location /assets/ {
    add_header Cache-Control "public, max-age=31536000, immutable";
    try_files $uri =404;
  }

  # Rewritten from API_URL on every start, so it must never be cached.
  location = /config.js {
    add_header Cache-Control "no-store";
  }

  # Client-side routes (/users, /keys, ...) all load the app.
  location / {
    add_header Cache-Control "no-cache";
    try_files $uri /index.html;
  }
}
